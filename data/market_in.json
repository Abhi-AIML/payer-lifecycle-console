 "clock_note": "The 1-hour cashless authorization and 3-hour discharge authorization are in the IRDAI Master Circular on Health Insurance Business (29 May 2024). Grievance, appeal and Ombudsman timelines are not verified and must be checked before any claim in a pitch.",
 "reasons": {
  "TARIFF": {
   "code": "IN-TAR",
   "label": "Charge above agreed hospital tariff",
   "kind": "contractual",
   "edit": "Compare each billed charge with the hospital agreed tariff before submission.",
   "member": "The hospital agreed tariff for this item is lower than what was billed."
  },
  "ROOM_CAP": {
   "code": "IN-RENT",
   "label": "Room rent above policy limit",
   "kind": "reduction",
   "edit": "Check the chosen room against the policy room-rent limit when estimating the cost.",
   "member": "Your policy covers room rent only up to a daily limit, and the room chosen cost more."
  },
  "PROPORTIONATE": {
   "code": "IN-PROP",
   "label": "Proportionate deduction (room-linked charges)",
   "kind": "reduction",
   "edit": "Warn the patient about proportionate deductions when a room above the limit is chosen.",
   "member": "Because the room cost more than your limit, charges linked to the room are reduced in the same proportion."
  },
  "SUB_LIMIT": {
   "code": "IN-SUB",
   "label": "Procedure sub-limit reached",
   "kind": "reduction",
   "edit": "Show the procedure sub-limit in the pre-authorization estimate.",
   "member": "Your policy caps what it pays for this procedure."
  },
  "COPAY_PCT": {
   "code": "IN-COPAY",
   "label": "Co-payment applied",
   "kind": "member_share",
   "edit": "",
   "member": "Your policy requires you to pay a percentage of every admissible claim."
  },
  "NON_PAYABLE": {
   "code": "IN-NMED",
   "label": "Non-payable item",
   "kind": "denial",
   "edit": "Separate non-payable items on the bill before submission.",
   "member": "Items such as administrative charges and consumables are not payable under the policy."
  },
  "NOT_COVERED": {
   "code": "IN-EXCL",
   "label": "Excluded procedure",
   "kind": "denial",
   "edit": "Screen the procedure against policy exclusions before submission.",
   "member": "This procedure is excluded under your policy."
  },
  "WAITING_PERIOD": {
   "code": "IN-WAIT",
   "label": "Waiting period not completed",
   "kind": "denial",
   "edit": "Check the policy start date against waiting periods at pre-authorization.",
   "member": "Your policy has a waiting period for this treatment, and it was not complete on the admission date."
  },
  "DUPLICATE": {
   "code": "IN-DUP",
   "label": "Duplicate charge",
   "kind": "denial",
   "edit": "Detect repeated charges (same item, same date) before submission.",
   "member": "This charge repeats another charge on the same bill."
  },
  "SUM_INSURED": {
   "code": "IN-SI",
   "label": "Sum insured exhausted",
   "kind": "reduction",
   "edit": "Track the remaining sum insured when approving the estimate.",
   "member": "Your policy sum insured was reached."
  }
 },

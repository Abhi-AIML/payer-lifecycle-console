 "ambiguities": [
  {
   "category": "proportionate_scope",
   "title": "ICU charges and the proportionate deduction",
   "message": "The wording lists surgeon, anaesthesia, nursing and operation theatre fees as room-linked, and says implants, medicines, consumables and diagnostic tests are not reduced. It is silent on ICU charges. Published explanations disagree on ICU, and the IRDAI Master Circular on Health Insurance Business (29 May 2024) has no clause on it, so the policy wording governs. A reviewer must choose how to treat ICU, and should confirm it with the insurer.",
   "options": [
    {
     "value": "linked",
     "label": "ICU charges are room-linked and are reduced"
    },
    {
     "value": "icu_exempt",
     "label": "ICU charges are not reduced"
    }
   ]
  }
 ],
